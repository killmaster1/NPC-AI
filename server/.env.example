# Carregar explicitamente: set -a; . ./.env; set +a
NPC_AI_MODE=mock
OPENAI_MODEL=gpt-4.1-mini
# Defina OPENAI_API_KEY apenas no ambiente privado do Termux (não neste arquivo público).
# Token compartilhado com token= em npcai.ini. Vazio desativa autenticação local.
NPC_AI_TOKEN=
NPC_AI_API_TIMEOUT=20
NPC_AI_HISTORY=24
NPC_AI_MAX_CONVERSATIONS=128
NPC_AI_MAX_INFLIGHT=4
NPC_AI_MEMORY_TTL=3600
# Opcional, caminho privado gravável no Termux. IDs de peds não sobrevivem a outra sessão GTA.
NPC_AI_MEMORY_FILE=

# Gemini (opcional): NPC_AI_MODE=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
# Defina GEMINI_API_KEY apenas no ambiente privado do Termux.

# Propostas de dinheiro também são limitadas novamente no plugin.
NPC_AI_MONEY_MAX=200
# JSON Schema nativo dos provedores. Use 0 se o modelo não aceitar o schema;
# a instrução JSON e a validação local continuam obrigatórias.
NPC_AI_STRUCTURED_OUTPUT=1

# Retries adicionais para HTTP 429/500/502/503/504 e falhas de rede; orçamento total
# continua sendo NPC_AI_API_TIMEOUT e o prazo informado pelo plugin.
NPC_AI_API_RETRIES=2
